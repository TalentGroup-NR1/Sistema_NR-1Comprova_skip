# === Configurações do Supabase ===
# Estas variáveis devem ser configuradas na Vercel:
# Acesse Settings → Environment Variables → Production

# A URL do seu projeto Supabase (ex: https://alneozvrsuwszlkisbyo.supabase.co)
VITE_SUPABASE_URL=https://alneozvrsuwszlkisbyo.supabase.co

# A chave pública anon do projeto
# NUNCA use a service role key nestas variáveis VITE_
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# A mesma chave anon, mas mapeada caso dependências (como Stripe ou outras) prefiram este nome
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui
